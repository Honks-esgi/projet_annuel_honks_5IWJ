# Root environment template for Honks monorepo
# Fill real values in local .env files (not committed)

NODE_ENV=development
TAG=1.0.0

# Observability
GRAFANA_USER=toto
GRAFANA_PASSWORD=toto

PROMETHEUS_URL=
LOKI_URL=
TEMPO_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318

# Mobile
# Docker-only: 'api' resolves inside the Docker network.
# For physical devices or emulators, use your machine's LAN IP: http://192.168.x.x:3000
EXPO_PUBLIC_API_URL=http://api:3000