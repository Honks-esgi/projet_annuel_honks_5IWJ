# never commit .env
POSTGRES_USER=honks
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=honks

NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001
DATABASE_URL=postgresql://honks:change-me-locally@localhost:5432/honks
REDIS_URL=redis://localhost:6379

TAG=1.0.0

DB_HOST=localhost
DB_PORT=5432
DB_USER=honks
DB_PASSWORD=change-me-locally
DB_NAME=honks

JWT_SECRET=<32+ caractères aléatoires>
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<autre valeur, différente de JWT_SECRET>
JWT_REFRESH_EXPIRES_IN=7d

# used by `npm run seed:admin` (apps/api) to create the initial admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<mot de passe fort, local uniquement>

GRAFANA_USER=toto
GRAFANA_PASSWORD=toto

PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
TEMPO_URL=http://tempo:3200

OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318

EXPO_PUBLIC_API_URL=http://api:3000
